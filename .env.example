# Copie este arquivo para ".env" e ajuste os valores.

# --- LLM ---
# backend: "ollama" (serve localmente o modelo fine-tunado) ou "mock" (para dev/testes)
LLM_BACKEND=mock
OLLAMA_MODEL_NAME=medassist-llama3-8b
OLLAMA_HOST=http://localhost:11434

# --- Hugging Face (para publicar/baixar o adapter LoRA gerado no Colab) ---
HF_TOKEN=
HF_REPO_ID=seu-usuario/medassist-lora-adapter

# --- Banco de dados de prontuários (SQLite local) ---
DATABASE_URL=sqlite:///data/processed/hospital.db

# --- Vector store (RAG) ---
CHROMA_PERSIST_DIR=data/processed/chroma_db
EMBEDDING_BACKEND=hash   # "hash" (dev/teste, offline) ou "sentence-transformers" (produção)

# --- Anonimização ---
ANONYMIZER_BACKEND=regex  # "regex" (dev/teste, offline) ou "presidio" (produção)

# --- Auditoria ---
AUDIT_LOG_PATH=data/processed/audit_log.jsonl
